compilation_database_dir: build
output_directory: docs/uml
add_compile_flags:
  - -resource-dir=/usr/lib/clang/22

diagrams:
  class_diagram:
    type: class
    glob:
      - src/**/*.cpp
      - src/**/*.h
    include:
      namespaces:
        - application
        - assets
        - domain
        - events
        - graphics
        - platform
        - renderer
        - rheo
        - simulation
        - ui
    exclude:
      namespaces:
        - std
        - vk
        - glm
        - ImGui
        - YAML

  package_diagram:
    type: package
    glob:
      - src/**/*.cpp
      - src/**/*.h
    include:
      namespaces:
        - application
        - assets
        - domain
        - events
        - graphics
        - platform
        - renderer
        - rheo
        - simulation
        - ui
